{
  "name": "miro-canvas",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "description": "Miro's look and Miro's tools on Obsidian's own Canvas.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "mcp:build": "node esbuild.mcp.mjs",
    "cli:build": "node esbuild.mcp.mjs --cli",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "schema:check": "node scripts/sync-schema.mjs --check",
    "schema:sync": "node scripts/sync-schema.mjs",
    "submission:check": "node scripts/check-submission.mjs",
    "lint": "eslint src --cache",
    "lint:mcp": "eslint --config mcp/eslint.config.mjs mcp/src",
    "lint:css": "node scripts/check-css.mjs",
    "lint:report": "eslint src --format json --output-file tools/obsidian_cdp/.out/lint-report.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "postcss": "8.5.29",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "html2canvas-pro": "2.5.0",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.8.1"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
